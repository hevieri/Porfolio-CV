---
import type { SectionConfig } from '@/types/shared';
import Icon from './icon.astro';

export interface Props extends SectionConfig {}

const { icon, slug, title } = Astro.props;
---

<a
  href={`#${slug}`}
  class="inline-flex h-8 items-center gap-2 rounded-md px-2.5 text-[11px] font-semibold uppercase tracking-wider transition-all"
  aria-label={`${title} section`}
  data-tooltip={title}
  data-tooltip-placement="bottom"
>
  <Icon name={icon} size={16} />
  <span class="hidden sm:inline">{title}</span>
</a>

<style>
  [aria-current='page'] {
    @apply bg-primary-600/20 text-primary-400;
  }

  :not([aria-current='page']) {
    @apply text-gray-400 hover:bg-gray-700/50 hover:text-gray-200;
  }
</style>
