---
import type { Tag } from '@/types/shared';
import Icon from './icon.astro';
import Typography from './typography.astro';

export interface Props extends Tag {}

const { name, description, icon, iconColor, url } = Astro.props;

const className = /* tw */ 'flex h-6 w-fit items-center gap-x-1.5 rounded-md border border-gray-700 px-2.5 bg-transparent transition-all duration-200 hover:translate-x-1';
const customProps = url
  ? ({
      href: url,
      as: 'a',
      target: '_blank',
      rel: 'noopener noreferrer',
      class: `${className} hover:border-primary-400 hover:text-primary-400`,
    } as const)
  : {
      class: className,
    };
---

<Typography variant="tag" data-tooltip={description} {...customProps}>
  {icon && <Icon name={icon} color={iconColor} size={16} />}
  {name}
</Typography>
