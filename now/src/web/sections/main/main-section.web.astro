---
import type { MainSection } from '@/types/sections/main-section.types';
import DownloadButton from '@/web/components/download-button.astro';
import Icon from '@/web/components/icon.astro';
import SectionCard from '@/web/components/section-card.astro';

export interface Props extends MainSection {}

const { action, config, fullName, links, role } = Astro.props;

const isExternal = (url: string) => url.startsWith('http');

const socialClasses = /* tw */ [
  'inline-flex h-10 items-center gap-2 rounded-lg border border-gray-700/80 bg-gray-900/70 px-4 text-sm font-medium text-gray-300',
  'backdrop-blur transition-all hover:-translate-y-0.5 hover:border-primary-500/60 hover:text-primary-300',
  'focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500',
  'active:translate-y-px',
].join(' ');
---

<SectionCard {...config} hideTitle>
  <div class="relative overflow-hidden rounded-3xl border border-gray-800 bg-gray-950/60">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute -left-24 -top-32 h-80 w-80 rounded-full bg-primary-500/25 blur-[110px]"></div>
      <div class="absolute -bottom-40 -left-16 h-80 w-80 rounded-full bg-[#e879f9]/12 blur-[110px]"></div>
      <div
        class="absolute right-0 top-0 h-80 w-[26rem] bg-[radial-gradient(rgba(255,255,255,0.14)_1.2px,transparent_1.2px)] [background-size:16px_16px] [-webkit-mask-image:linear-gradient(to_left,black,transparent)] [mask-image:linear-gradient(to_left,black,transparent)]"
      >
      </div>

      <div class="absolute -right-16 top-8 hidden sm:block lg:-right-16">
        <div class="floaty relative h-56 w-56 sm:h-64 sm:w-64 lg:h-72 lg:w-72">
          <div class="absolute inset-0 rounded-full bg-gradient-to-br from-[#8b5cf6]/50 via-[#7c3aed]/25 to-[#e879f9]/45"></div>
          <div class="absolute -inset-4 rounded-full border border-primary-500/40"></div>
          <div class="absolute -inset-14 rounded-full border border-white/10"></div>
          <span class="absolute -left-1 top-6 h-3 w-3 rounded-full bg-[#e879f9]"></span>
        </div>
      </div>

      <div class="absolute left-8 top-24 h-24 w-24 rounded-full bg-gradient-to-tr from-[#8b5cf6]/45 to-transparent blur-xl"></div>
      <div class="absolute bottom-6 right-12 h-16 w-16 rounded-full border border-white/10"></div>
      <div class="absolute bottom-14 right-32 h-2 w-2 rounded-full bg-primary-400/70"></div>
    </div>

    <div class="relative flex max-w-3xl flex-col gap-6 px-6 py-14 sm:px-10 sm:py-20">
      <span class="font-mono text-xs uppercase tracking-[0.25em] text-gray-500">Hola, soy</span>

      <h1 class="font-display text-5xl font-bold leading-[0.92] tracking-tighter text-gray-50 sm:text-6xl lg:text-7xl">
        {fullName}
      </h1>

      <p class="flex items-center gap-3">
        <span class="h-2 w-2 rounded-full bg-gradient-to-br from-[#8b5cf6] to-[#e879f9]" aria-hidden="true"></span>
        <span
          class="bg-gradient-to-r from-primary-300 via-primary-400 to-[#e879f9] bg-clip-text text-lg font-medium text-transparent"
        >
          {role}
        </span>
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-3">
        <DownloadButton {...action} />
        {
          links.map((link) => (
            <a
              href={link.url}
              target={isExternal(link.url) ? '_blank' : undefined}
              rel={isExternal(link.url) ? 'noopener noreferrer' : undefined}
              aria-label={link.name}
              data-tooltip={link.name}
              class={socialClasses}
            >
              <Icon name={link.icon} size={16} />
              {link.name}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</SectionCard>

<style>
  .floaty {
    animation: floaty 9s ease-in-out infinite;
  }

  @keyframes floaty {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-16px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floaty {
      animation: none;
    }
  }
</style>
