---
export interface Props {
  name: string;
  label?: string;
  level: number;
}

const { name, label, level } = Astro.props;

const cefrLetters = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
const maxLevel = cefrLetters.length;
const isNative = label?.toLowerCase() === 'nativo';
const filled = isNative ? maxLevel : Math.min(level, maxLevel);
const segments = Array.from({ length: maxLevel }, (_, i) => i < filled);
---

<div class="flex flex-col gap-2">
  <div class="flex items-baseline justify-between gap-4">
    <span class="flex items-center gap-2 font-display text-sm font-bold tracking-tight text-gray-100">
      <slot name="icon" />
      {name}
    </span>
    {label && <span class="text-sm text-gray-400">{label}</span>}
  </div>
  <div class="flex gap-1">
    {
      segments.map((on) => (
        <span class:list={['h-2 flex-1 rounded-sm', on ? 'bg-primary-400' : 'bg-gray-800']} />
      ))
    }
  </div>
  <div class="flex gap-1">
    {
      cefrLetters.map((letter) => (
        <span class="flex-1 text-center text-[9px] tracking-wide text-gray-600">{letter}</span>
      ))
    }
  </div>
</div>
